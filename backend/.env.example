UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=change-me-to-a-random-string
DATABASE_URL=sqlite:///./data/app.db
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_ENABLED=true
ANTHROPIC_API_KEY=

# The app always runs against the built-in mock Upstox client (synthetic
# instruments + a Kafka-driven simulated tick feed) — UPSTOX_API_KEY/SECRET
# are currently unused (real_client.py is kept but unreferenced; see
# app/upstox_client/__init__.py to switch back).
#
# KAFKA_ENABLED can be set to false to skip starting the tick producer and
# consumers (used by the test suite, which has no broker available).
#
# `docker compose up redpanda` exposes Redpanda's OUTSIDE listener on
# localhost:19092 for a host-run backend (this .env); the containerized
# backend instead talks to it over the compose network at redpanda:9092
# (see docker-compose.yml).
#
# ANTHROPIC_API_KEY powers the "Ask Claude" chat panel (app/chat/) —
# get a key at console.anthropic.com and paste it here. The key is only
# ever used server-side; the browser never sees it. Without it, the chat
# endpoints will fail (the rest of the app works fine either way).
